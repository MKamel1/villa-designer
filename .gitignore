# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Generated drawing output -- everything here is regenerated from spec/
out/

# Autodesk working files
*.bak
*.dwl
*.dwl2
*.rvt.*
*.slog
plot.log
*.log

# Revit/AutoCAD models are authored artifacts, not source. The extract
# (.model.json) is what belongs in git -- see ADR-0002.
*.rvt
*.rfa
*.rte

# Tooling
.playwright-mcp/
.DS_Store
.mcp.json
.codex/config.toml
Thumbs.db
out/families/*.rfa
out/families/too-new/*.rfa
out/revit2027/*.rvt

# User-supplied and manufacturer downloads (luminaire libraries, bed models):
# third-party files are never committed; manifests record their source and hash.
assets/user/

# Client brief documents and third-party reference images: referenced by
# knowledge/projects/*/taste.json, never committed.
villa_*_guidelines.docx
villa_*_guidelines_images/

# Books and standards dropped by the client: licensed originals, never committed.
# scripts/sources.py intake files them into the private store (ARCHPIPE_SOURCES).
sources/

# local secrets and manual downloads (never commit)
sketchfab-api.txt
assets-incoming/
